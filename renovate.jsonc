// Dependency updates, as pull requests that CI has already judged.
//
// Renovate runs self-hosted from .github/workflows/renovate.yml, as the same
// GitHub App as maxstreese/maxnix and maxstreese/maxi-me, because the skills
// sync below is a postUpgradeTask and Mend's hosted app does not run those.
// The settings only the operator may set are in
// .github/renovate-global.jsonc; this file is the per-repository part.
//
// What pins what: pyproject.toml pins every Python package exactly (uv.lock
// the rest); flake.lock pins the toolchain the dev shell brings, the Python
// interpreter (nixpkgs' python314) among it. pyproject.toml asks only for
// Python 3.14.x, so the exact version lives in one place: a second exact pin
// would break the lock on every nixpkgs bump with a Python patch release, as
// .python-version beside requires-python once did (PR #1, 2026-11-08).
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",

    // Rewrites every `uses:` in .github/workflows from a tag to the commit
    // SHA it resolves to, keeping the tag as a comment. Tags are mutable,
    // commits are not, and an action added later gets pinned without anyone
    // remembering to.
    "helpers:pinGitHubActionDigests",

    // Updates `FOO_VERSION:` values in workflows that carry a
    // `# renovate: datasource=… depName=…` comment: Renovate's own version in
    // renovate.yml.
    "customManagers:githubActionsVersions"
  ],

  "timezone": "Europe/Berlin",

  // Runs are started by the workflow, nightly or with
  // `gh workflow run renovate.yml`, and the PRs are the record of what is
  // pending. A run's warnings show only in its log.
  "dependencyDashboard": false,

  // The nix manager is in beta and ships disabled; without this Renovate
  // never looks at flake.nix or flake.lock, silently.
  "nix": {
    "enabled": true
  },

  // nixpkgs follows a branch and has no version to bump, and the packages
  // uv.lock holds only transitively never move through a version bump: this
  // refresh, of flake.lock and uv.lock together, is the only way they move.
  // It is off by default and config:recommended does not turn it on.
  //
  // "at any time" because the workflow's cron decides when Renovate runs;
  // otherwise this falls back to its own Monday-morning default.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },

  // Every PR is rebuilt once it falls behind main, not only when it
  // conflicts. The default rebases on a mere lag only with automerge or a
  // branch protection rule requiring up-to-date branches, and this repository
  // has neither, so an open PR would sit at its first version.
  "rebaseWhen": "behind-base-branch",

  // text-to-cad's library (`cad`), server (`cad-server`) and MCP server
  // (`cad-mcp`) are all in pyproject.toml, released together. cad-server
  // requires cad at its own release, so uv cannot lock those two apart;
  // cad-mcp declares nothing, and scripts/sync_skills.py (in CI) fails while
  // any of the three differs. The group below puts them in the same PR.

  "packageRules": [
    {
      // The lock refresh keeps its own PR (Renovate always gives it a branch
      // of its own): the update types are listed so it is not swept in.
      //
      // The topic and extra are pinned so the PR is "Update dependencies"
      // however many updates it holds; Renovate otherwise titles a group of
      // one as if ungrouped, and the same branch keeps changing name.
      "description": "All version bumps in one PR",
      "commitMessageTopic": "dependencies",
      "commitMessageExtra": "",
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "pinDigest", "digest", "rollback", "bump", "replacement"],
      "groupName": "dependencies"
    },
    {
      // Everything pinned in a workflow file: action SHAs, Renovate's own
      // image, any other tool version. None of it changes what is built, only
      // the pipeline, and Renovate alone releases several times a day, so
      // these come on Mondays only (Europe/Berlin, which the nightly run
      // always falls on). Matched by file because the image comes from a
      // regex manager, not github-actions.
      //
      // Its own group because a schedule cannot be set per update inside one:
      // a branch takes its config from whichever upgrade sorts first.
      // updateNotScheduled false so an open PR also waits for Monday. The
      // topic makes the PR "Update CI"; the rule above would otherwise title
      // it "Update dependencies" too.
      "description": "Workflow pins weekly, in their own PR",
      "matchFileNames": [".github/workflows/**"],
      "groupName": "ci",
      "commitMessageTopic": "CI",
      "schedule": ["* * * * 1"],
      "updateNotScheduled": false
    },
    {
      // Without it a bump would widen `==` into a range rather than replace
      // it.
      "description": "pyproject pins stay exact",
      "matchManagers": ["pep621"],
      "rangeStrategy": "pin"
    },
    {
      // The interpreter is nixpkgs' python314, pinned by flake.lock and moved
      // by the lock refresh; requires-python only says 3.14.x. A move to 3.15
      // is by hand (flake.nix and requires-python): cadquery-ocp, under
      // build123d and cad, has no wheels for 3.15 yet (cp311-cp314,
      // 2026-11-08).
      "description": "requires-python is not Renovate's to bump",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      // The agent skills in .claude/skills/ are copied from the release `cad`
      // is locked at; CI fails while they lag behind it. This copies the new
      // release's into the same PR. `update` mode, so it runs for this update
      // even inside the grouped PR. Allow-listed exactly in
      // .github/renovate-global.jsonc.
      "description": "Sync the vendored text-to-cad skills after a cad bump",
      "matchPackageNames": ["cad"],
      "postUpgradeTasks": {
        "commands": ["uv run scripts/sync_skills.py"],
        "fileFilters": [".claude/skills/**"],
        "installTools": { "uv": {} },
        "executionMode": "update"
      }
    }
  ],

  // CI proves the lock installs and every part still builds and exports; it
  // cannot tell whether a part still fits. Every PR is read by a human.
  "automerge": false
}
