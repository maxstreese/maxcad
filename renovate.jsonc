// Dependency updates, as pull requests that CI has already judged.
//
// Renovate runs self-hosted from .github/workflows/renovate.yml, as the same
// GitHub App as maxstreese/maxnix and maxstreese/maxi-me. This repository
// needs no postUpgradeTask, which was the reason those two self-host: uv.lock
// is regenerated by Renovate's own pep621 manager, with uv. Mend's hosted app
// would work here too; self-hosted keeps the three repositories alike. The
// settings only the operator may set are in .github/renovate-global.jsonc;
// this file is the per-repository part.
//
// Every version is pinned exactly (pyproject.toml, mise.toml), so each
// update shows up as a version bump.
//
// Python is pinned once, in requires-python: with no .python-version, uv
// takes the interpreter from it. A .python-version beside it was a second
// pin, read by Renovate's pyenv manager from Docker's python tags while
// requires-python comes from the python-version datasource. The two drifted
// apart (PR #1, 2026-11-08: requires-python bumped, .python-version not),
// and uv refuses that combination.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",

    // Rewrites every `uses:` in .github/workflows from a tag to the commit
    // SHA it resolves to, keeping the tag as a comment. Tags are mutable,
    // commits are not, and an action added later gets pinned without anyone
    // remembering to.
    "helpers:pinGitHubActionDigests",

    // Updates `FOO_VERSION:` values in workflows that carry a
    // `# renovate: datasource=… depName=…` comment: Renovate's own version in
    // renovate.yml, and mise's in checks.yml.
    "customManagers:githubActionsVersions"
  ],

  "timezone": "Europe/Berlin",

  // Runs are started by the workflow, nightly or with
  // `gh workflow run renovate.yml`, and the PRs are the record of what is
  // pending. A run's warnings show only in its log.
  "dependencyDashboard": false,

  // The packages uv.lock holds only transitively never move through a
  // version bump: this refresh is the only way they do. It is off by default
  // and config:recommended does not turn it on.
  //
  // "at any time" because the workflow's cron decides when Renovate runs;
  // otherwise this falls back to its own Monday-morning default.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },

  // Every PR is rebuilt once it falls behind main, not only when it
  // conflicts. The default rebases on a mere lag only with automerge or a
  // branch protection rule requiring up-to-date branches, and this repository
  // has neither, so an open PR would sit at its first version.
  "rebaseWhen": "behind-base-branch",

  "customManagers": [
    {
      // The library (`cad`, in pyproject.toml) refuses a server of another
      // release, and the server is installed once per machine from the
      // README's setup line. This keeps that line at the library's version;
      // both land in the same PR through the group below. After merging,
      // run the line once locally.
      "customType": "regex",
      "description": "cad-server in the README's setup line",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["--from cad-server==(?<currentValue>[0-9][0-9.]*)"],
      "depNameTemplate": "cad-server",
      "datasourceTemplate": "pypi"
    }
  ],

  "packageRules": [
    {
      // The lock refresh keeps its own PR (Renovate always gives it a branch
      // of its own): the update types are listed so it is not swept in.
      //
      // The topic and extra are pinned so the PR is "Update dependencies"
      // however many updates it holds; Renovate otherwise titles a group of
      // one as if ungrouped, and the same branch keeps changing name.
      "description": "All version bumps in one PR",
      "commitMessageTopic": "dependencies",
      "commitMessageExtra": "",
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "pinDigest", "digest", "rollback", "bump", "replacement"],
      "groupName": "dependencies"
    },
    {
      // Without it a bump would widen `==` into a range rather than replace
      // it. Covers requires-python too.
      "description": "pyproject pins stay exact",
      "matchManagers": ["pep621"],
      "rangeStrategy": "pin"
    },
    {
      // uv downloads the interpreter from python-build-standalone, whose
      // build of a new release can lag the release itself. Without a wait,
      // that PR's CI would fail at `uv sync` until it appears.
      "description": "New Python releases wait until uv can download them",
      "matchDepNames": ["python"],
      "minimumReleaseAge": "3 days"
    },
    {
      // cadquery-ocp (OpenCascade, under build123d and cad) ships wheels up
      // to cp314 only (8.0.1.1, 2026-11-08), so a 3.15 bump cannot install.
      // Patch releases still come. Lift once it ships cp315.
      "description": "Python stays on 3.14 until OCP has wheels for 3.15",
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ],

  // CI proves the lock installs and every part still builds and exports; it
  // cannot tell whether a part still fits. Every PR is read by a human.
  "automerge": false
}
